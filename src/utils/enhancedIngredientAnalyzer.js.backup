// Chemical additives and preservatives database
const CHEMICAL_ADDITIVES_DATABASE = {
  // Sulfates
  'sodium lauryl sulfate': { type: 'Surfactant', riskLevel: 'high', concerns: ['Skin irritation', 'Eye irritation'] },
  'sodium laureth sulfate': { type: 'Surfactant', riskLevel: 'moderate', concerns: ['Skin irritation'] },
  'ammonium lauryl sulfate': { type: 'Surfactant', riskLevel: 'high', concerns: ['Skin irritation'] },
  
  // Parabens
  'methylparaben': { type: 'Preservative', riskLevel: 'high', concerns: ['Endocrine disruption', 'Allergic reactions'] },
  'ethylparaben': { type: 'Preservative', riskLevel: 'high', concerns: ['Endocrine disruption'] },
  'propylparaben': { type: 'Preservative', riskLevel: 'high', concerns: ['Endocrine disruption'] },
  'butylparaben': { type: 'Preservative', riskLevel: 'high', concerns: ['Endocrine disruption'] },
  'parabens': { type: 'Preservative', riskLevel: 'high', concerns: ['Endocrine disruption'] },
  
  // Formaldehyde releasers
  'formaldehyde': { type: 'Preservative', riskLevel: 'high', concerns: ['Cancer risk', 'Allergic reactions'] },
  'quaternium-15': { type: 'Preservative', riskLevel: 'high', concerns: ['Formaldehyde release'] },
  'dmdm hydantoin': { type: 'Preservative', riskLevel: 'high', concerns: ['Formaldehyde release'] },
  'imidazolidinyl urea': { type: 'Preservative', riskLevel: 'moderate', concerns: ['Formaldehyde release'] },
  
  // Other concerning chemicals
  'triclosan': { type: 'Antimicrobial', riskLevel: 'high', concerns: ['Endocrine disruption', 'Antibiotic resistance'] },
  'triclocarban': { type: 'Antimicrobial', riskLevel: 'high', concerns: ['Endocrine disruption'] },
  'phthalates': { type: 'Plasticizer', riskLevel: 'high', concerns: ['Endocrine disruption'] },
  'bha': { type: 'Antioxidant', riskLevel: 'high', concerns: ['Cancer risk'] },
  'bht': { type: 'Antioxidant', riskLevel: 'high', concerns: ['Cancer risk'] },
  'toluene': { type: 'Solvent', riskLevel: 'high', concerns: ['Neurological effects'] },
  'coal tar': { type: 'Colorant', riskLevel: 'high', concerns: ['Cancer risk'] },
  'lead acetate': { type: 'Colorant', riskLevel: 'high', concerns: ['Heavy metal toxicity'] },
  'hydroquinone': { type: 'Skin lightener', riskLevel: 'high', concerns: ['Cancer risk', 'Skin damage'] }
};

const getAdditiveSafetyLevel = (eNumber) => {
  const additiveData = COMPREHENSIVE_ADDITIVE_DATABASE[eNumber.toUpperCase()];
  if (additiveData) {
    // Map new risk levels to old safety levels for compatibility
    switch (additiveData.riskLevel) {
      case 'low': return 'safe';
      case 'moderate': return 'moderate';
      case 'high': return 'concerning';
      default: return 'moderate';
    }
  }
  return 'safe'; // Default for unknown E-numbers
};

const getColorByLevel = (level) => {
  switch (level) {
    case 'safe': return '#4CAF50';
    case 'moderate': return '#4CAF50';     // Changed to green (was orange)
    case 'concerning': return '#F44336';
    default: return '#9E9E9E';
  }
};

const getAdditiveSafetyColor = (eNumber) => {
  return getColorByLevel(getAdditiveSafetyLevel(eNumber));
};

const isAdditive = (ingredient) => {
  return checkForAdditive(ingredient) !== null;
};

const getAdditiveType = (ingredient) => {
  const additiveInfo = checkForAdditive(ingredient);
  return additiveInfo ? additiveInfo.type : 'Unknown Additive';
};

export const getENumber = (ingredient) => {
  const cleanIngredient = ingredient.toLowerCase();
  const eNumberMatch = cleanIngredient.match(/^e(\d{3,4}[a-z]?)$/);
  return eNumberMatch ? eNumberMatch[0].toUpperCase() : null;
};

